# Copy this file to `.env.local` for local development, and add the VITE_*
# variables in your hosting provider's dashboard (Vercel / Netlify).

# Supabase → Project Settings → API. The anon key is meant to be public:
# row-level security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: the property shown at the site root (/). Copy the slug from the
# share link in the admin dashboard (…/#/p/<slug>). Without it, visitors need
# the property's own link.
VITE_PROPERTY_SLUG=

# --- Only for the one-time import (scripts/import-jsonbin.mjs) ---------------
# Never prefix the service role key with VITE_: that would put it in the
# browser bundle, and it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
VITE_JSONBIN_BIN_ID=
VITE_JSONBIN_ACCESS_KEY=
