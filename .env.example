# Copy this file to `.env.local` for local development, and add the VITE_*
# variables in your hosting provider's dashboard (Cloudflare Pages).

# Supabase → Project Settings → API. The anon key is meant to be public:
# row-level security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: the property shown at the site root (/). Copy the slug from the
# share link on the property page (…/p/<slug>). Without it, the root shows the
# home page, and visitors need the property's own link.
VITE_PROPERTY_SLUG=

# CardCom payments: CARDCOM_API_NAME, CARDCOM_TERMINAL_NUMBER, CRON_SECRET and
# APP_URL are NOT env vars. They are Supabase edge function secrets
# (npx supabase secrets set …, see README step 11). Never put them here or in
# a VITE_* variable: the browser never talks to CardCom.
