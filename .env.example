# Copy this file to `.env.local` for local development, and add the same
# variables in your hosting provider's dashboard (Vercel / Netlify).

# The ID of your bin on jsonbin.io (the long hex string in the bin URL)
VITE_JSONBIN_BIN_ID=

# A jsonbin.io Access Key with ONLY "Bins: Read" and "Bins: Update" permissions.
# (Recommended over the Master Key — see README.)
VITE_JSONBIN_ACCESS_KEY=
